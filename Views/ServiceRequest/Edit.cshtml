@model ST10448420_TechMove_GLMS.Models.ViewModels.ServiceRequestViewModel
@{
    ViewData["Title"] = "Edit Service Request";
}

<h2>Edit Service Request #@Model.RequestID</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="col-md-7">
    @Html.AntiForgeryToken()
    <input asp-for="RequestID" type="hidden" />
    <input asp-for="ContractID" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Service Description</label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CostUSD" class="form-label">Estimated Cost (USD)</label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="CostUSD" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="CostUSD" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="File" class="form-label">Replace Document (leave blank to keep existing)</label>
        <input asp-for="File" type="file" accept=".pdf" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>