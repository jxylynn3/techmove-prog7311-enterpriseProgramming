@model List<Contract>

<h2>Your Contracts</h2>

<table class="table">
    <tr>
        <th>Start</th>
        <th>End</th>
        <th>Status</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StartDate</td>
            <td>@item.EndDate</td>
            <td>@item.Status</td>
            <td>
                <a asp-controller="Contract"
                       asp-action="Details"
                       asp-route-id="@item.ContractID">
                    View
                </a>
            </td>
        </tr>
    }
</table>