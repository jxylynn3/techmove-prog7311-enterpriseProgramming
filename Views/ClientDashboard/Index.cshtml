@model List<ST10448420_TechMove_GLMS.Models.Contract>
@{
    ViewData["Title"] = "My Dashboard";
}

<h2>Welcome, Client Dashboard</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex gap-2 mb-4">
    <a asp-controller="ServiceRequest" asp-action="Index" class="btn btn-outline-info">My Service Requests</a>
</div>

<h4>My Contracts</h4>

@if (!Model.Any())
{
    <div class="alert alert-warning">You have no contracts yet. Please contact TechMove.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var c in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Contract #@c.ContractID</strong>
                        <span class="badge bg-@(c.Status == "Active" ? "success" : c.Status == "Expired" ? "danger" : c.Status == "OnHold" ? "warning" : "secondary")">
                            @c.Status
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Service Level:</strong> @c.ServiceLevel</p>
                        <p class="mb-1"><strong>From:</strong> @c.StartDate.ToString("dd MMM yyyy") — <strong>To:</strong> @c.EndDate.ToString("dd MMM yyyy")</p>
                        <p class="mb-1"><strong>Service Requests:</strong> @(c.ServiceRequests?.Count ?? 0)</p>
                    </div>
                    <div class="card-footer d-flex gap-2 flex-wrap">
                        <a asp-controller="Contract" asp-action="Details" asp-route-id="@c.ContractID"
                           class="btn btn-sm btn-outline-primary">View Contract</a>

                        <a href="@c.SignedAgreementFilePath" target="_blank"
                           class="btn btn-sm btn-outline-secondary">📄 Download PDF</a>

                        <a asp-controller="Contract" asp-action="ReuploadPdf" asp-route-id="@c.ContractID"
                           class="btn btn-sm btn-outline-warning">🔄 Re-upload PDF</a>

                        @if (c.CurrentState.contractCanRaiseServiceRequest())
                        {
                            <a asp-controller="ServiceRequest" asp-action="Create" asp-route-contractId="@c.ContractID"
                               class="btn btn-sm btn-success">+ Service Request</a>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-outline-danger disabled"
                                  title="Contract must be Active to raise a service request">
                                Service Request Blocked
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}