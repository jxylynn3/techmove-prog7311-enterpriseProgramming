@model IEnumerable<ST10448420_TechMove_GLMS.Models.Contract>

<h2>My Contracts</h2>

@foreach (var c in Model)
{
    <div>
        <p>Contract: @c.ContractID</p>
        <p>Status: @c.Status</p>

        <a asp-controller="Contract" asp-action="Details" asp-route-id="@c.ContractID">
            View Details
        </a>
    </div>
}