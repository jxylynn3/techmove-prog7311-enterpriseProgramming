@model ST10448420_TechMove_GLMS.Models.Contract
@{
    ViewData["Title"] = "Contract Details";
}

<h2>Contract #@Model.ContractID</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.Client?.Name</dd>
    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">End Date</dt>
    <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Service Level</dt>
    <dd class="col-sm-9">@Model.ServiceLevel</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge bg-@(Model.Status == "Active" ? "success" : Model.Status == "Expired" ? "danger" : Model.Status == "OnHold" ? "warning" : "secondary")">
            @Model.Status
        </span>
    </dd>
    <dt class="col-sm-3">Contract PDF</dt>
    <dd class="col-sm-9">
        <a href="@Model.SignedAgreementFilePath" target="_blank" class="btn btn-sm btn-outline-primary">📄 Download PDF</a>
        @if (User.IsInRole("Client"))
        {
            <a asp-action="ReuploadPdf" asp-route-id="@Model.ContractID" class="btn btn-sm btn-outline-warning ms-2">🔄 Re-upload PDF</a>
        }
    </dd>
</dl>

<h4 class="mt-4">Service Requests</h4>
@if (Model.ServiceRequests != null && Model.ServiceRequests.Any())
{
    <table class="table table-sm table-bordered">
        <thead><tr><th>#</th><th>Description</th><th>Status</th><th>Created</th></tr></thead>
        <tbody>
            @foreach (var r in Model.ServiceRequests)
            {
                <tr>
                    <td>@r.RequestID</td>
                    <td>@r.Description</td>
                    <td><span class="badge bg-secondary">@r.Status</span></td>
                    <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No service requests yet.</p>
}

@if (User.IsInRole("Admin") || User.IsInRole("LogisticsManager"))
{
    <a asp-action="Edit" asp-route-id="@Model.ContractID" class="btn btn-warning">Edit</a>
}
<a asp-controller="Admin" asp-action="Index" class="btn btn-secondary ms-2">← Back</a>