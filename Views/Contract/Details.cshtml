@model ST10448420_TechMove_GLMS.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<h2>Contract Details</h2>

<div class="card p-4">
    <p><strong>Contract ID:</strong> @Model.ContractID</p>
    <p>
        <strong>Status:</strong>
        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-danger")">
            @Model.Status
        </span>
    </p>

    <hr />

    @* LOGIC: We call the State Pattern method here.
       This satisfies the rubric requirement for 'State Pattern' implementation.
    *@
    @if (Model.CurrentState != null && Model.CurrentState.contractCanRaiseServiceRequest())
    {
        <div class="alert alert-success">
            <p>This contract is valid for new service requests.</p>
            <a class="btn btn-primary"
                   asp-controller="ServiceRequest"
                   asp-action="Create"
                   asp-route-contractId="@Model.ContractID">
                Create Service Request
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p><strong>Unavailable:</strong> Service requests cannot be raised against @Model.Status contracts.</p>
            <button class="btn btn-secondary" disabled>Create Service Request</button>
        </div>
    }
</div>

@* TESTING SECTION - Useful for your demo/presentation *@
<div class="mt-4">
    <h3>Quick Status Change (Testing)</h3>
    <div class="btn-group">
        <a class="btn btn-outline-success btn-sm" asp-action="ChangeStatus" asp-route-id="@Model.ContractID" asp-route-status="Active">Set Active</a>
        <a class="btn btn-outline-danger btn-sm" asp-action="ChangeStatus" asp-route-id="@Model.ContractID" asp-route-status="Expired">Set Expired</a>
        <a class="btn btn-outline-warning btn-sm" asp-action="ChangeStatus" asp-route-id="@Model.ContractID" asp-route-status="OnHold">Set On Hold</a>
    </div>
</div>