@model List<Contract>

<h2>Contracts</h2>

<a asp-action="Create">Create New</a>

<table>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Client?.Name</td>
            <td>@c.Status</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.ContractID">Edit</a> |
                <a asp-action="Delete" asp-route-id="@c.ContractID">Delete</a>
            </td>
        </tr>
    }
</table>