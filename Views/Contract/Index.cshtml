@{
}
@model IEnumerable<ST10448420_TechMove_GLMS.Models.Contract>

<h2>Contracts</h2>

<table>
    <tr>
        <th>ID</th>
        <th>Client</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td>@c.ContractID</td>
            <td>@c.Client?.Name</td>
            <td>@c.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@c.ContractID">View</a>
            </td>
        </tr>
    }
</table>