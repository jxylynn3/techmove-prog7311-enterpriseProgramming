@{
    ViewData["Title"] = "Home";
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .hero {
        height: 100vh;
        width: 100vw; /* THIS FIXES SIDE GAPS */
        margin: 0;
        padding: 0;
        background: url('/images/wall.jpg') no-repeat center center;
        background-size: cover;
        position: relative;
    }

        .hero::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.2);
        }

    .hero-content {
        position: relative; /* sits above overlay */
        z-index: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
        font-family: 'Segoe UI', sans-serif;
    }

        .hero-content h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .hero-content p {
            font-size: 1.2rem;
        }
</style>

<div class="hero">
    <div class="hero-content">
        <p>TechMove GLMS</p>
        <p>Smart logistics. Seamless management.</p>

        @* Part 3: Link to the backend API's Swagger UI.
           The API runs on http://localhost:5245 and serves Swagger at its root
           because RoutePrefix = string.Empty is configured in the API Program.cs. *@
        <a href="http://localhost:5245"
           target="_blank"
           class="btn btn-outline-light mt-4"
           style="font-size:1rem; padding: 0.6rem 1.6rem; border-radius: 30px;">
            🔌 Open Swagger API
        </a>
    </div>
</div>