@model List<ST10448420_TechMove_GLMS.Models.ViewModels.UserWithRoleViewModel>

@{
    ViewData["Title"] = "Manage Users";
    // Using the standard layout to keep the Navy/Deep Blue theme
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary">Manage Users</h2>
            <p class="text-muted">Total System Users: @Model.Count</p>
        </div>
        <div>
            <a asp-action="CreateUser" class="btn btn-primary shadow-sm">+ New User</a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Back to Contracts</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Linked Client</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><strong>@u.UserName</strong></td>
                            <td>@u.Email</td>
                            <td>
                                @* Dynamic badge color based on role *@
                                <span class="badge @(u.Role == "Admin" ? "bg-danger" : u.Role == "LogisticsManager" ? "bg-info" : "bg-success")">
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                @* If no client name exists (like for an Admin), show a dash *@
                                @(string.IsNullOrEmpty(u.ClientName) ? "—" : u.ClientName)
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="EditUser" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-warning">Edit</a>
                                    
                                    <form asp-action="DeleteUser" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete @u.UserName?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>