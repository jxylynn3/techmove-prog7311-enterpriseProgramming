@{
}
@model IEnumerable<ST10448420_TechMove_GLMS.Models.ApplicationUser>

<h2>Manage Users</h2>

<table>
    <tr>
        <th>Email</th>
        <th>Client</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.Client?.Name</td>
        </tr>
    }
</table>