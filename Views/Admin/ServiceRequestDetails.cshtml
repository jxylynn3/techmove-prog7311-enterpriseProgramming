@model ST10448420_TechMove_GLMS.Models.ServiceRequest
@{
    ViewData["Title"] = "Service Request — " + Model.RequestID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page">
    <div class="breadcrumb">
        <a asp-action="ServiceRequests" asp-controller="Admin">← Back to requests</a>
    </div>
    <div class="page-head">
        <div class="page-title">SR-@Model.RequestID.ToString("D5")</div>
        <span class="badge badge-@Model.Status.ToLower()">@Model.Status</span>
    </div>

    <div class="detail-grid">
        <div class="card">
            <div class="card-title">Request details</div>
            <div class="dr"><span>Client</span><strong>@Model.Contract?.Client?.Name</strong></div>
            <div class="dr"><span>Contract ID</span><strong>@Model.ContractID</strong></div>
            <div class="dr"><span>Description</span><strong>@Model.Description</strong></div>
            <div class="dr"><span>Submitted</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong></div>
            <div class="dr"><span>Status</span><strong>@Model.Status</strong></div>
        </div>
        <div class="card">
            <div class="card-title">Cost breakdown (ZAR)</div>
            <div class="dr"><span>Cost (USD)</span><strong>$ @Model.CostUSD.ToString("N2")</strong></div>
            <div class="dr"><span>Cost (ZAR)</span><strong>R @(Model.CostZAR.ToString("N2"))</strong></div>
        </div>
    </div>
</div>