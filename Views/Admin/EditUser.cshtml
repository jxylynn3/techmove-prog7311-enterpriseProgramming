@model ST10448420_TechMove_GLMS.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:520px;margin:2rem auto">
    <h2 style="font-family:'Syne',sans-serif;color:#21295C;margin-bottom:1.5rem">Edit User</h2>

    <form asp-action="EditUser" method="post">
        @Html.AntiForgeryToken()

        @* Pass the Id through as a hidden field so the POST action receives it *@
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger" style="font-size:11px"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">Role</label>
            <select asp-for="Role" class="form-select">
                <option value="">-- Select Role --</option>
                <option value="Admin">Admin</option>
                <option value="LogisticsManager">Logistics Manager</option>
                <option value="Client">Client</option>
            </select>
            <span asp-validation-for="Role" class="text-danger" style="font-size:11px"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ClientID" class="form-label">Linked Client (optional)</label>
            <select asp-for="ClientID" class="form-select">
                <option value="">-- None --</option>
                @foreach (var client in Model.Clients ?? new List<ST10448420_TechMove_GLMS.Models.Client>())
                {
                    <option value="@client.ClientID">@client.Name</option>
                }
            </select>
        </div>

        <div style="display:flex;gap:8px;margin-top:1.5rem">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="ManageUsers" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}