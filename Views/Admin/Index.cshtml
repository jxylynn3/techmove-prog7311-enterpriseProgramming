@* Part 3 refactor: model changed from List<Contract> (EF entity) to List<ContractApiDTO>
   because AdminController.Index now fetches data from the API, not the database directly.
   c.Client?.Name is replaced with c.ClientName (the DTO includes client name already). *@
@model List<ST10448420_TechMove_GLMS.ApiServices.ContractApiDTO>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard — Contracts</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

<!-- Search & Filter Form -->
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="search" class="form-control" placeholder="Client name..."
               value="@ViewBag.Search" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
            <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
            <option value="OnHold" selected="@(ViewBag.Status == "OnHold")">On Hold</option>
            <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expired</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<div class="mb-3">
    <a asp-controller="Contract" asp-action="Create" class="btn btn-success">+ New Contract</a>
    <a asp-action="ManageUsers" class="btn btn-outline-dark ms-2">Manage Users</a>
    <a asp-action="ServiceRequests" class="btn btn-outline-info ms-2">Service Requests</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Client</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Service Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ContractID</td>
                @* Part 3: c.ClientName replaces c.Client?.Name — DTO carries this directly *@
                <td>@c.ClientName</td>
                <td>@c.StartDate.ToString("dd MMM yyyy")</td>
                <td>@c.EndDate.ToString("dd MMM yyyy")</td>
                <td>
                    <span class="badge bg-@(c.Status == "Active" ? "success" : c.Status == "Expired" ? "danger" : c.Status == "OnHold" ? "warning" : "secondary")">
                        @c.Status
                    </span>
                </td>
                <td>@c.ServiceLevel</td>
                <td>
                    <a asp-controller="Contract" asp-action="Details" asp-route-id="@c.ContractID"
                       class="btn btn-sm btn-info">View</a>
                    <a asp-controller="Contract" asp-action="Edit" asp-route-id="@c.ContractID"
                       class="btn btn-sm btn-warning">Edit</a>

                    <!-- Change Status — calls AdminController.ChangeStatus via API -->
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.ContractID" />
                        <select name="status" class="form-select form-select-sm d-inline w-auto">
                            <option value="Draft" selected="@(c.Status == "Draft")">Draft</option>
                            <option value="Active" selected="@(c.Status == "Active")">Active</option>
                            <option value="OnHold" selected="@(c.Status == "OnHold")">On Hold</option>
                            <option value="Expired" selected="@(c.Status == "Expired")">Expired</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-secondary">Set</button>
                    </form>

                    <form asp-controller="Contract" asp-action="Delete" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this contract?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.ContractID" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>