@model List<ST10448420_TechMove_GLMS.Models.ServiceRequest>
@{
    ViewData["Title"] = "All Service Requests";
}

<h2>Service Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Index" class="btn btn-outline-secondary mb-3">← Dashboard</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Client</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.RequestID</td>
                <td>@r.Contract?.Client?.Name</td>
                <td>@r.Description</td>
                <td>$@r.CostUSD.ToString("N2")</td>
                <td>R@r.CostZAR.ToString("N2")</td>
                <td>
                    <span class="badge bg-@(r.Status == "Approved" ? "success" : r.Status == "Rejected" ? "danger" : r.Status == "Draft" ? "secondary" : "warning")">
                        @r.Status
                    </span>
                </td>
                <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                <td>
                    <a asp-action="ServiceRequestDetails" asp-route-id="@r.RequestID" class="btn btn-sm btn-info">View</a>
                    <a asp-action="EditServiceRequest" asp-route-id="@r.RequestID" class="btn btn-sm btn-warning">Edit</a>

                    <!-- Approve/Reject -->
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.RequestID" />
                        <button type="submit" class="btn btn-sm btn-success"
                                onclick="return confirm('Approve this request?')">
                            Approve
                        </button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.RequestID" />
                        <button type="submit" class="btn btn-sm btn-secondary"
                                onclick="return confirm('Reject this request?')">
                            Reject
                        </button>
                    </form>
                    <form asp-action="DeleteServiceRequest" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this request? This cannot be undone.')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.RequestID" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>