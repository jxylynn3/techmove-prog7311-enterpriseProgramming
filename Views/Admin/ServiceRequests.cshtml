@* Part 3 refactor: model changed from List<ServiceRequest> (EF entity) to
   List<ServiceRequestApiDTO> because AdminController.ServiceRequests now fetches
   data from the API. Navigation property r.Contract?.Client?.Name is no longer
   available on the DTO — the contract ID is shown instead. *@
@model List<ST10448420_TechMove_GLMS.ApiServices.ServiceRequestApiDTO>
@{
    ViewData["Title"] = "All Service Requests";
}

<h2>Service Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

<a asp-action="Index" class="btn btn-outline-secondary mb-3">← Dashboard</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Contract ID</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.RequestID</td>
                @* Part 3: ContractID shown instead of r.Contract?.Client?.Name
                   because the DTO does not carry the full navigation graph *@
                <td>Contract #@r.ContractID</td>
                <td>@r.Description</td>
                <td>$@r.CostUSD.ToString("N2")</td>
                <td>R @r.CostZAR.ToString("N2")</td>
                <td>
                    <span class="badge bg-@(r.Status == "Approved" ? "success" : r.Status == "Rejected" ? "danger" : r.Status == "Draft" ? "secondary" : "warning")">
                        @r.Status
                    </span>
                </td>
                <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                <td>
                    <!-- Approve -->
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.RequestID" />
                        <button type="submit" class="btn btn-sm btn-success"
                                onclick="return confirm('Approve this request?')">
                            Approve
                        </button>
                    </form>
                    <!-- Reject -->
                    <form asp-action="Reject" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.RequestID" />
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Reject this request?')">
                            Reject
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>