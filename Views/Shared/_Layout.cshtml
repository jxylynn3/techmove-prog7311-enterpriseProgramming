<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ST10448420_TechMove_GLMS</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ST10448420_TechMove_GLMS.styles.css" asp-append-version="true" />

<style>
    *, *::before, *::after { box-sizing: border-box; }

    html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    body {
        background: url('/images/wall.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    /* Strip all container padding so home page bleeds edge to edge */
    .container-fluid.p-0,
    main[role="main"] {
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Interior pages (not home) get padding restored via .interior-page */
    .interior-page {
        padding: 1.5rem 1rem;
        background: rgba(230,235,239,0.92);
        min-height: calc(100vh - 52px);
    }

    .navbar {
        background: #21295C !important;
        backdrop-filter: none !important;
    }
    .navbar .nav-link,
    .navbar .navbar-brand { color: rgba(230,235,239,0.8) !important; }
    .navbar .nav-link:hover { color: #E6EBEF !important; }
    .navbar .text-primary  { color: rgba(230,235,239,0.6) !important; }

    footer {
        background: rgba(33,41,92,0.85);
        color: #E6EBEF;
        padding: 1rem 0;
        font-size: 12px;
    }
    footer .border-top { border-color: rgba(230,235,239,.15) !important; }
</style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow ">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">GLMS TechMove</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="ManageUsers">Manage Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Contract" asp-action="Index">Contracts</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="ServiceRequests">Service Requests</a>
                                </li>
                            }

                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ClientDashboard" asp-action="Index">My Dashboard</a>
                                </li>
                            }

                            @if (User.IsInRole("LogisticsManager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ServiceRequest" asp-action="Create">Create Request</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Contract" asp-action="Index">Contracts</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- LOGIN / LOGOUT -->
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-primary">Hello, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

<div class="container-fluid p-0">
    <main role="main" class="p-0 m-0">
        @RenderBody()
    </main>
</div>

    <footer class="border-top text-white mt-5">
        <div class="container">
            &copy; 2026 - ST10448420_TechMove_GLMS
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>